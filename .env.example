# path: .env.example
# KD SOLUTION IT environment template.
# Copy this file to .env.local for local development. Never commit real secrets.
# The server validates these variables at boot with Zod and fails fast when a
# required value is missing or malformed (see lib/config/env.ts).

# Public application base URL used for metadata, canonical links, and absolute
# redirects. Optional in development (defaults to http://localhost:3000).
# In production set the exact deployed origin, for example https://app.example.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Structured log level for server output. One of: debug, info, warn, error.
LOG_LEVEL=info

# Sentry data source name for error monitoring with PII scrubbing.
# Optional in Step 01; the monitoring pipeline is wired in a later step.
SENTRY_DSN=

# Optional reporting endpoint for Content-Security-Policy violation reports.
CSP_REPORT_URI=

# --- Step 02: secure data plane ---------------------------------------------
# Set to "true" when deploying the data plane; in production this makes the
# six variables below hard boot requirements. Omit (or "false") while a
# deployment serves foundation surfaces only.
KD_DATA_PLANE_ENABLED=

# Supabase project URL such as https://your-project.supabase.co.
# Required in production; optional in development until Step 02 services are used.
SUPABASE_URL=

# Supabase anon (publishable) key for the browser session.
# Required in production.
SUPABASE_ANON_KEY=

# Supabase service role key. Server-only; never exposed to the browser.
# Required in production.
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string for privileged server-side access used
# by migration tooling and server repositories.
# Example: postgres://postgres:postgres@127.0.0.1:5432/kd_platform
# Required in production.
KD_DATABASE_URL=

# AES-256-GCM data-plane encryption master key: base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32
# Required in production. Never commit a real value.
KD_ENCRYPTION_MASTER_KEY=

# Integer version of the data-plane encryption key currently in use (>= 1).
# Bump when rotating keys; ciphertext keeps its recorded key version.
# Required in production.
KD_ENCRYPTION_KEY_VERSION=
