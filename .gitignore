# path: .gitignore
# Dependencies
/node_modules

# Next.js build output
/.next/
/out/

# Generated type entry points (regenerated by next typegen)
/next-env.d.ts

# Environment files (never commit secrets)
.env
.env.local
.env.development
.env.production
.env.test
!.env.example

# TypeScript incremental build info
*.tsbuildinfo

# Generated design token export (run npm run tokens:export)
/public/design-tokens.json

# Husky internal directory
.husky/_/

# Logs and coverage
*.log
/coverage

# OS metadata
.DS_Store
Thumbs.db
