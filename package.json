{
  "name": "kd-solution-it",
  "version": "0.1.0",
  "private": true,
  "description": "KD SOLUTION IT - enterprise multi-tenant SaaS platform for invoicing, payments, payroll, accounting, and business operations",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:export": "node scripts/export-design-tokens.mjs",
    "scan:english": "bash scripts/check-english-only.sh",
    "scan:headers": "bash scripts/check-path-headers.sh",
    "scan:tests": "bash scripts/check-no-tests.sh",
    "scan:markers": "bash scripts/check-no-unfinished-markers.sh",
    "scan:routes": "node scripts/check-nav-routes.mjs",
    "scan:migrations": "node scripts/db/lint-migrations.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:rollback": "node scripts/db/rollback.mjs",
    "db:assert": "node scripts/db/assert.mjs",
    "acceptance:step02": "node scripts/acceptance/step-02/all.mjs",
    "quality:scans": "npm run scan:english && npm run scan:headers && npm run scan:tests && npm run scan:markers && npm run scan:routes && npm run scan:migrations",
    "quality": "npm run quality:scans && npm run format:check && npm run lint && npm run typecheck",
    "quality:audit": "npm audit --omit=dev --audit-level=high",
    "quality:all": "npm run quality && npm run build && npm run quality:audit",
    "quality:precommit": "npm run quality:scans && npm run format:check && npm run lint && npm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "decimal.js": "10.6.0",
    "framer-motion": "14.2.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "husky": "9.1.7",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
